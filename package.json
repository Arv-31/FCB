{
  "name": "match-intel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "validate:data": "node --max-old-space-size=4096 node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.node.json scripts/validateData.ts",
    "test:logic": "tsx --tsconfig tsconfig.node.json scripts/smokeTest.ts",
    "data:download": "tsx scripts/data/download.ts",
    "data:build": "node --max-old-space-size=4096 node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.node.json scripts/data/build.ts",
    "test:generated": "node --max-old-space-size=4096 node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.node.json scripts/smokeGenerated.ts",
    "setup": "npm run data:download && npm run data:build"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
